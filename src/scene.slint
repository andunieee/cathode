import { Button, Slider, LineEdit, ListView, ScrollView, ComboBox, HorizontalBox, VerticalBox, Palette } from "std-widgets.slint";

export struct SearchResult {
    id: string,
    title: string,
    channel: string,
    channel_id: string,
    details: string,
    thumbnail: image,
}

export struct VideoDetails {
    id: string,
    title: string,
    channel: string,
    channel_id: string,
    meta: string,
    description: string,
    thumbnail: image,
}

// A channel name that takes you to the channel's page.
component ChannelLink inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 12px;
    callback clicked();

    width: label.preferred-width;
    height: label.preferred-height;

    label := Text {
        text: root.text;
        font-size: root.font-size;
        color: Palette.accent-background;
        overflow: elide;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ResultCard inherits Rectangle {
    in property <SearchResult> result;
    callback open-video();
    callback open-channel();

    height: 84px;
    background: card-area.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;

    card-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            open-video();
        }
    }

    HorizontalBox {
        Rectangle {
            width: 112px;
            background: Palette.foreground.with-alpha(0.1);
            Image {
                source: result.thumbnail;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: result.title;
                color: Palette.foreground;
                font-weight: 600;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                ChannelLink {
                    text: result.channel;
                    clicked => {
                        open-channel();
                    }
                }
                Text {
                    text: result.details;
                    color: Palette.foreground.with-alpha(0.6);
                    overflow: elide;
                }
            }
        }
    }
}

export component App inherits Window {
    preferred-width: 1000px;
    preferred-height: 700px;
    title: "Lumpla";
    background: playing ? transparent : Palette.background;

    out property <length> window_width: self.width;
    out property <length> window_height: self.height;

    // Browsing state. `page` is one of "search", "channel" and "video".
    in-out property <bool> playing: false;
    in-out property <bool> busy: false;
    in-out property <string> status;
    in-out property <string> page: "search";
    in-out property <bool> can_back: false;
    in-out property <bool> can_forward: false;

    in-out property <[SearchResult]> results;
    in-out property <string> query_text;
    in-out property <int> sort_index: 0;
    in-out property <string> channel_name;
    in-out property <string> channel_query;
    in-out property <VideoDetails> video;

    callback search(string, bool);
    callback search-channel(string);
    callback open-video(string);
    callback open-channel(string, string);
    callback play-video();
    callback go-back();
    callback go-forward();

    // Player state
    in-out property <bool> is_paused;
    in-out property <float> seek_position: 0;
    in-out property <string> ts_label: "00:00:00 / 00:00:00";

    in-out property <image> play_icon: @image-url("../assets/play-solid.svg");
    in-out property <image> pause_icon: @image-url("../assets/pause-solid.svg");

    in-out property <float> new_position: 0;
    in-out property <bool> position_ackd: true;

    if !playing : VerticalBox {
        HorizontalBox {
            Button {
                text: "Back";
                enabled: can_back;
                clicked => {
                    go-back();
                }
            }
            Button {
                text: "Forward";
                enabled: can_forward;
                clicked => {
                    go-forward();
                }
            }
            if page == "search" : HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                LineEdit {
                    placeholder-text: "Search YouTube";
                    text <=> query_text;
                    accepted(text) => {
                        search(text, sort_index == 1);
                    }
                }
                ComboBox {
                    model: ["Relevance", "Newest"];
                    current-index <=> sort_index;
                    selected => {
                        if query_text != "" {
                            search(query_text, sort_index == 1);
                        }
                    }
                }
                Button {
                    text: "Search";
                    clicked => {
                        search(query_text, sort_index == 1);
                    }
                }
            }
            if page == "channel" : HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    text: channel_name;
                    color: Palette.foreground;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                LineEdit {
                    placeholder-text: "Search this channel";
                    text <=> channel_query;
                    accepted(text) => {
                        search-channel(text);
                    }
                }
                Button {
                    text: "Search";
                    clicked => {
                        search-channel(channel_query);
                    }
                }
            }
            if page == "video" : Rectangle {
                horizontal-stretch: 1;
            }
        }

        Text {
            text: status;
            color: Palette.foreground;
            horizontal-alignment: center;
        }

        if page != "video" : ListView {
            for result in results : ResultCard {
                result: result;
                open-video => {
                    open-video(result.id);
                }
                open-channel => {
                    open-channel(result.channel_id, result.channel);
                }
            }
        }

        if page == "video" : VerticalBox {
            HorizontalBox {
                alignment: start;
                Rectangle {
                    width: 320px;
                    height: 180px;
                    background: Palette.foreground.with-alpha(0.1);
                    Image {
                        source: video.thumbnail;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: 8px;
                    Text {
                        text: video.title;
                        color: Palette.foreground;
                        font-size: 20px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    ChannelLink {
                        text: video.channel;
                        font-size: 14px;
                        clicked => {
                            open-channel(video.channel_id, video.channel);
                        }
                    }
                    Text {
                        text: video.meta;
                        color: Palette.foreground.with-alpha(0.6);
                    }
                    Button {
                        text: "Play";
                        primary: true;
                        enabled: !busy;
                        clicked => {
                            play-video();
                        }
                    }
                }
            }
            ScrollView {
                Text {
                    text: video.description;
                    color: Palette.foreground;
                    wrap: word-wrap;
                    width: parent.visible-width;
                }
            }
        }
    }

    if playing : VerticalBox {
        Rectangle {
            background: #ffffff00;
        }

        Rectangle {
            background: #ffffffaa;
            height: 50px;
            HorizontalBox {
                HorizontalLayout {
                    Button {
                        text: "Back";
                        clicked => {
                            is_paused = true;
                            playing = false;
                        }
                    }
                    Button {
                        width: 55px;
                        icon: !is_paused ? pause_icon : play_icon;
                        clicked => {
                            is_paused = !is_paused;
                        }
                    }
                    HorizontalBox {
                        horizontal-stretch: 1;
                        padding-top: 12px;

                        Slider {
                            width: 100%;
                            height: 12px;
                            value: seek_position * 100;
                            changed(value) => {
                                new_position = value;
                                position_ackd = false;
                                seek_position = value;
                            }
                        }
                    }

                    HorizontalBox {
                        padding-top: 12px;
                        Text {
                            text: ts_label;
                            color: #000000;
                        }
                    }
                }
            }
        }
    }
}
