{
  "manifest_version": 3,
  "name": "Open in Cathode",
  "description": "Open YouTube videos, playlists and channels in Cathode (Alt+C, the toolbar button, or the right-click menu)",
  "version": "1.0",
  "permissions": ["activeTab", "contextMenus", "scripting"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open in Cathode" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}
